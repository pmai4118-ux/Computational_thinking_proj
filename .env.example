# Reference environment variables for the server process (loaded by source.config.load_settings).
# Keep real secrets, local .env files, and SQLite databases out of Git.
# Never expose API keys to browser JavaScript, logs, or screenshots.

# Provider mode:
# - antigravity : Primary live AI mode via signed-in local Antigravity CLI (`agy`) (default on Demo).
# - gemini      : Alternative live AI mode via Gemini Developer REST API (requires GEMINI_API_KEY + GEMINI_MODEL).
# - fixture     : Explicit offline deterministic mode for development/tests; UI labels output "Dữ liệu minh họa".
EVALUATION_PROVIDER=antigravity

# SQLite database path. Paths inside this checkout must be under .local/ or end with .sqlite3.
# Use a new path when testing updated seed records against an existing local database.
DATABASE_PATH=.local/interview.sqlite3

# Primary live provider (Antigravity CLI subscription — selected in P07):
ANTIGRAVITY_MODEL=gemini-3.8-flash-medium
ANTIGRAVITY_TIMEOUT_SECONDS=120
ANTIGRAVITY_EXECUTABLE=agy

# Alternative live provider (Gemini Developer REST API):
# Set EVALUATION_PROVIDER=gemini together with both GEMINI_MODEL and GEMINI_API_KEY in the server shell.
# Keep these blank in version control.
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MODEL=
GEMINI_API_KEY=

# Shared request safety limits and retry budget (E08):
# GEMINI_MAX_RETRIES accepts 0 or 1. run_demo.ps1 defaults this to 0 so the student decides whether to retry.
GEMINI_MAX_RETRIES=1
GEMINI_REQUEST_BUDGET=50
GEMINI_INPUT_BYTES=250000
GEMINI_RESPONSE_BYTES=1000000
GEMINI_OUTPUT_TOKENS=4096