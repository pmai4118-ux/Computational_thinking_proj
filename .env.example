# Reference for server process environment variables.
# Demo uses a real Antigravity evaluation by default. Sign in with `agy` on the server.
EVALUATION_PROVIDER=antigravity
DATABASE_PATH=.local/interview.sqlite3

# Primary live evaluation option (Antigravity CLI subscription - chosen in P07):
ANTIGRAVITY_MODEL=gemini-3.8-flash-medium
ANTIGRAVITY_TIMEOUT_SECONDS=120
ANTIGRAVITY_EXECUTABLE=agy

# Alternative live option (direct Gemini Developer REST API key):
# Set EVALUATION_PROVIDER=gemini together with both GEMINI_MODEL and GEMINI_API_KEY.
# For deterministic offline tests only, set EVALUATION_PROVIDER=fixture explicitly.
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MODEL=
GEMINI_API_KEY=
